# Configuración del servidor. Completar en un archivo local ignorado por Git
# o en las variables protegidas del alojamiento.
SUPABASE_URL=
# Clave Secret de Supabase (sb_secret_...), solo servidor.
SUPABASE_SECRET_KEY=
# Clave publicable de Supabase (sb_publishable_...). Se usa solo para el intercambio de entrada.
SUPABASE_PUBLISHABLE_KEY=
# Cada proveedor de entrada se enciende con «activa». Su botón solo aparece si lo está.
ENTRADA_GOOGLE=
ENTRADA_APPLE=
ENTRADA_FACEBOOK=

# Opcional: origen HTTPS estable de OAuth por entorno; autorizar /api/entrar/retorno en Supabase.
# NORKA_ORIGEN_ENTRADA=https://tu-dominio-de-prueba.example
